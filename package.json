{
  "name": "bjbc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "typecheck:edge": "npx --yes deno@2.9.6 check --frozen --config=supabase/functions/deno.json supabase/functions/receipt-view/index.ts supabase/functions/receipt-submit/index.ts",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project database",
    "test:integration": "node --env-file-if-exists=.env.test.local scripts/run-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "node --env-file=.env.test.local node_modules/@playwright/test/cli.js test --config=playwright.live.config.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "functions:serve": "supabase functions serve receipt-view",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:verify": "node scripts/verify-db-types.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
